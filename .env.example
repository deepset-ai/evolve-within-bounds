# Copy to .env and fill in. Never commit .env.
# The local model server (vLLM or NIM), loopback only.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# Local servers need no key, but the OpenAI client wants one: any placeholder works.
OPENAI_API_KEY=EMPTY
# Model downloads from Hugging Face.
HF_TOKEN=
# NVIDIA NIM containers from NGC.
NGC_API_KEY=
# The knowledge base's vector store.
KB_QDRANT_URL=http://localhost:6333
